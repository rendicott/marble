{
  "drivers": {
    "grok": {
      "enabled": true,
      "command": "grok",
      "default_output_format": "json",
      "default_args": [
        "--no-plan",
        "--effort",
        "medium",
        "--max-turns",
        "40"
      ],
      "auto_approve": true
    },
    "claude": {
      "enabled": true,
      "command": "claude",
      "default_output_format": "json",
      "default_args": [],
      "auto_approve": true
    }
  },
  "default_timeout_sec": 900,
  "max_timeout_sec": 1800,
  "max_per_session": 10,
  "max_output_bytes": 1048576,
  "system_agents_enabled": false,
  "stuck_after_sec": 480,
  "stuck_kill": false,
  "context": {
    "default": ["full", "memory"],
    "max_chars": 16000
  }
}
